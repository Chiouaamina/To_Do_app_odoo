<odoo>
    <data>
        <!-- Tree View for "projet.list" -->
<record id="view_projet_list" model="ir.ui.view">
    <field name="name">projet.list</field>
    <field name="model">todo_app.projet</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name" class="form-control"/>
            <field name="description" class="form-control"/>
            <field name="date_debut" class="form-control"/>
            <field name="date_fin" class="form-control"/>
            <field name="document" widget='binary'/>
            <field name="employe_ids" widget="many2many_tags"/>
            <field name="image" widget='image' options='{"preview_image": "image", "size": [90, 90]}'/>
        </tree>
    </field>
</record>

<!-- Form View for "projet.form" -->
<record id="view_projet_form" model="ir.ui.view">
    <field name="name">projet.form</field>
    <field name="model">todo_app.projet</field>
    <field name="arch" type="xml">
        <form string="Projet">
            <sheet>
                <group>
                    <field name="name" class="form-control"/>
                    <field name="description" class="form-control"/>
                    <field name="date_debut" class="form-control"/>
                    <field name="date_fin" class="form-control"/>
                    <field name="document" widget='binary'/>
                    <field name="employe_ids" widget="many2many_tags"/>
                    <field name="image" widget='image' options='{"preview_image": "image", "size": [90, 90]}'/>
                </group>
            </sheet>
        </form>
    </field>
</record>

        <!-- Action for Projet -->
        <record id="action_projet" model="ir.actions.act_window">
            <field name="name">Projets</field>
            <field name="res_model">todo_app.projet</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_projet_list"/>
        </record>

        <!--Menu Item for Projet -->
        <menuitem id="menu_projet_main" name="Projets"/>
        <menuitem id="menu_projet" name="Gestion des Projets" parent="menu_projet_main" action="action_projet"/>
    </data>
</odoo>
